# ---------------------------------------------------------------------------
# ResolveAI — example environment. Copy to backend/.env and adjust.
# The web app reads frontend/.env.local (see frontend/.env.example).
# ---------------------------------------------------------------------------

# --- Runtime -----------------------------------------------------------------
ENVIRONMENT=development          # development | production
APP_URL=http://localhost:3000    # the dashboard, used for CORS on /api
PUBLIC_API_URL=http://localhost:8000   # where widget.js and /widget/* are served

# --- Database ----------------------------------------------------------------
# SQLite by default. For PostgreSQL:
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/resolveai
DATABASE_URL=sqlite:///./resolveai.db

# --- Security ----------------------------------------------------------------
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_TTL_MINUTES=720
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
ALLOW_REGISTRATION=true

# --- AI provider ----------------------------------------------------------------
# mock   — deterministic, extractive answers built from retrieved articles.
#          No network, no API key, no cost. The default.
# openai — any OpenAI-compatible Chat Completions endpoint.
AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Point at any OpenAI-compatible server (Azure, a local gateway, …).
OPENAI_BASE_URL=https://api.openai.com/v1
AI_TIMEOUT_SECONDS=30
AI_MAX_OUTPUT_TOKENS=500

# --- Retrieval --------------------------------------------------------------------
# How many passages are sent to the model, and the relevance score below which
# a question is treated as unanswerable (and marked unresolved) instead of
# being sent to the model with weak context.
RETRIEVAL_TOP_K=4
RETRIEVAL_MIN_SCORE=1.2

# --- Limits -------------------------------------------------------------------------
MAX_QUESTION_CHARS=500
MAX_ARTICLE_CHARS=50000
# Widget requests per minute, per visitor IP and per knowledge base.
WIDGET_RATE_PER_MINUTE=20
